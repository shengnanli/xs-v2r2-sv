    puts "MQ_PREPIN_END MissQueue n=$n expect=$_expect"
    if {$n != $_expect} {
        puts "MQ_PREPIN_ERROR: pinned $n but expected $_expect"
        error "MQ_PREPIN_COUNT=$n"
    }
}
_mq_pre_pin
