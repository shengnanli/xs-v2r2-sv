    # 解析 -encoding 形式)。入口与 emitter 非 source 载入, 在此显式登记快照。
    # appvar 拦截 = execution trace 加在命令本身 + phase(match 后冻结)+ 写历史。
    set ::SIDECAR_SOURCED {}
    sidecar_register_script $_entry
    sidecar_register_script $_emit
    sidecar_install_appvar_guard
