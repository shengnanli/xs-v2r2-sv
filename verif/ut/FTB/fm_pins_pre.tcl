# FTB FM「匹配前」钉点 —— 自动生成：scripts/gen_ftb.py（勿手改）
#
# 只消 golden 扁平寄存器名（firtool 按 dup/字段展开）与重写核按结构体/数组存放之间的命名鸿沟。
# set_user_match 只声明两点对应，比较照比：不约束 ref、不改 appvar、不加黑盒。
# fail-closed：set_user_match 从不抛异常（返回 0 = 没配上），所以逐条数返回值；
# 拒一条或总数不等于字面整数（= golden FTB 顶层寄存器位数）就 error（safe interp 里不用 exit）。
# 子模块（ftbBank / 三个延迟件）内部不钉，交给 FM 自动配对（两侧同实例名）。
# 进 fm.log 的输出一律 ASCII。
set ::FTB_PIN_EXPECT 3094
set ::FTB_PIN_OK 0
set ::FTB_PIN_BAD 0
proc ftb_pin {r i} {
  if {[set_user_match "r:/WORK/FTB/$r" "i:/WORK/FTB/u_core/$i"]} { incr ::FTB_PIN_OK } else {
    incr ::FTB_PIN_BAD
    if {$::FTB_PIN_BAD <= 10} { puts "FTB_PIN_FAIL: $r <-> $i" }
  }
}
puts "FTB_PIN_BEGIN FTB expect=$::FTB_PIN_EXPECT"
