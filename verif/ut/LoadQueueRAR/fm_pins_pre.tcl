# LoadQueueRAR FM「匹配前」钉点 —— 自动生成：scripts/gen_lqrar.py（勿手改）
#
# 只消 golden 扁平寄存器名与重写核按字段数组名之间的命名鸿沟（依据见生成器注释）。
# set_user_match 只是声明两点对应，比较照比：不约束 ref、不改 appvar、不加黑盒。
# fail-closed：set_user_match 从不抛异常（返回 0 = 没配上），所以逐条数返回值；
# 拒一条或总数不等于字面整数（= golden 顶层寄存器位数）就 error（safe interp 里不用 exit）。
# 子模块（paddrModule / freeList 及其延迟件）内部不钉，交给 FM 自动配对。
# 进 fm.log 的输出一律 ASCII。
set ::LQRAR_PIN_EXPECT 1741
set ::LQRAR_PIN_OK 0
set ::LQRAR_PIN_BAD 0
proc lqrar_pin {g i w} {
  if {$w == 1} {
    set pairs [list "r:/WORK/LoadQueueRAR/${g}_reg" "i:/WORK/LoadQueueRAR/u_core/${i}"]
  } else {
    set pairs {}
    for {set b 0} {$b < $w} {incr b} {
      lappend pairs "r:/WORK/LoadQueueRAR/${g}_reg\[$b\]" "i:/WORK/LoadQueueRAR/u_core/${i}\[$b\]"
    }
  }
  foreach {r m} $pairs {
    if {[set_user_match $r $m]} { incr ::LQRAR_PIN_OK } else {
      incr ::LQRAR_PIN_BAD
      if {$::LQRAR_PIN_BAD <= 10} { puts "LQRAR_PIN_FAIL: $r <-> $m" }
    }
  }
}
puts "LQRAR_PIN_BEGIN LoadQueueRAR expect=$::LQRAR_PIN_EXPECT"
