# golden 的 `ifndef SYNTHESIS 段调用未定义的 xs_assert_v2，两侧统一定义 SYNTHESIS。
# 初值档 INITREG（编译期打开机制，运行期选档）：只用两个常量档 0 / 1（全设计同值，两侧初态必相同）；
#   双例化下 +vcs+initreg+random 会让两侧各摇各的初值（CONVENTIONS「双例化 UT」，L2TLB 实测），不用。
VCS += +define+SYNTHESIS +vcs+initreg+random
INITREG ?= 0
ifeq ($(INITREG),0)
SIM_ARGS += +vcs+initreg+0
else ifeq ($(INITREG),1)
SIM_ARGS += +vcs+initreg+1
else
$(error INITREG 只认 0 / 1)
endif

.PHONY: gencheck gentb
gencheck:
	python3 ../../../scripts/gen_backend.py --check
	python3 gen.py --check
gentb:
	python3 gen.py
