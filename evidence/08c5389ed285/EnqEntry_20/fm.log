# ----------------------------------------------------------------------------
# 字段映射配对（在首次 match 之前全量钉死）：当手写核心把整个 payload 打包进一个
# 扁平寄存器 data_reg，而 golden 用逐字段寄存器 data_<suffix> 时，等宽字段会令签名
# 分析产生歧义、且会在重新 match 时互相搅乱。生成器输出「<suffix> <lo> <width>」
# 映射（FM_FIELD_MAP），这里据此把 ref 的 data_<suffix>_reg[b] 逐位 set_user_match
# 到 impl 的 u_core/data_reg[lo+b]，使后续 match 只需处理 valid 等非 payload 寄存器。
# 供 PipelineConnect 及后续扁平 payload 模块复用。
# ----------------------------------------------------------------------------
proc match_packed_payload { top } {
    if {![info exists ::env(FM_FIELD_MAP)] || ![file exists $::env(FM_FIELD_MAP)]} return
    # ★2026-09-20 补：把 field map 纳入字节快照★
    # agent/harvest 在核对 receipt 闭包时发现的洞：sidecar 的字节快照挂在 `source`
    # 上（sidecar_source_trace / sidecar_pin_source），而这里用 **open** 读 field map，
    # 于是这个文件一个字节都没进 script_closure.list、也没进 receipt。
    # 实测 NewPipelineConnectPipe_29 的 fm.log 写着 `PACKED_MATCH: 1023 points pinned`
    # —— ★1023 个 set_user_match 来自一份字节没留档的文件；换掉它 receipt 的 sha256
    #    一个都不变★。那不是记账问题，是证据完整性的洞：receipt 声称
    #    「证明输入的字节都在这里」，而实际少记了一个输入。
    # 这也是 harvest 那批里仅剩 2 个 NEEDS_RERUN 的全部原因（八项检查其余全过）。
    set _fmpath $::env(FM_FIELD_MAP)
    set fh [open $_fmpath rb]
    set _fmraw [read $fh]
    close $fh
    if {$::SIDECAR_ON} { sidecar_snapshot_buffer $_fmpath $_fmraw }
    # ★2026-10-03 改（agent/gatefix2，codex_0207 E1 同类）★：旧版对 1 位字段先试
    # `data_<suf>_reg[0]`、catch 失败再试 `data_<suf>_reg`。但 set_user_match 对不存在的
    # 名字**不抛异常**（返回 0，并在 log 里记一行 FM-036），catch 恒为 0，回退永远走不到、
    # 计数照增：当时用 field map 的 4 个目标（清单与重证见 docs/packed_payload_rerun_prereg.md）的
    # 1 位字段实际一个都没钉上，而 PACKED_MATCH 自报全数。golden 的 1 位寄存器是 `reg data_<suf>;`，
    # FM 名就是 `data_<suf>_reg`（无下标），多位是 `data_<suf>_reg[b]` —— 直接算真名，
    # 用**返回值**判成败，期望数 = field map 各行位宽之和，miss != 0 或 n != 期望 即中止。
    set n 0; set miss 0; set expect 0
    foreach ln [split [encoding convertfrom utf-8 $_fmraw] "\n"] {
        if {![regexp {^(\S+)\s+(\d+)\s+(\d+)$} $ln -> suf lo w]} continue
        incr expect $w
        for {set b 0} {$b < $w} {incr b} {
            set ipath "i:/WORK/$top/u_core/data_reg\[[expr {$lo + $b}]\]"
            if {$w == 1} {
                set rpath "r:/WORK/$top/data_${suf}_reg"
            } else {
                set rpath "r:/WORK/$top/data_${suf}_reg\[$b\]"
            }
            if {[set_user_match $rpath $ipath]} {
                incr n
            } else {
                incr miss
                if {$miss <= 10} { puts "PACKED_MATCH_FAIL: $rpath <-> $ipath" }
            }
        }
    }
    puts "PACKED_MATCH: $n points pinned (miss=$miss expect=$expect)"
    if {$miss != 0 || $n != $expect} {
        puts "FM_PIN_ERROR: PACKED_MATCH pinned $n miss $miss expect $expect -- field map names drifted, refuse to continue"
        exit 3
    }
}
# 模块本地「匹配前」钉点(FM_PIN_PRE_TCL, 可选): 首次 match 前需 set_user_match 的对象。
# 四审: sidecar 下 pin 代码进受限 safe child interp(sidecar_pin_source: 一次读取→快照
# →child 执行同一缓冲; 拿不到父层 guard/trace/证据目录; 嵌套 source 走同一受控入口)。
if {[info exists env(FM_PIN_PRE_TCL)] && [file exists $env(FM_PIN_PRE_TCL)]} {
    if {$SIDECAR_ON} { sidecar_pin_source $env(FM_PIN_PRE_TCL) } else { source $env(FM_PIN_PRE_TCL) }
}
