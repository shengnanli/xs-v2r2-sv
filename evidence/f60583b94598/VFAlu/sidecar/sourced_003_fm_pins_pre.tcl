# =============================================================================
# fm_pins_pre.tcl —— VFAlu「匹配前」钉点（只 set_user_match，不约束 ref）
#
# 要消的名差全在两个 VectorFloatAdder 子实例（vfalus_0 / vfalus_1）里：与 VectorFloatAdder 自签核用的同一套
#   verif/ut/VectorFloatAdder/fm_pins_pre.tcl（536 对：64 位 lane 本体语义名 + 三条 lane close 子树的同源双份寄存器），
#   逐字照搬，只把顶层前缀换成本层实例路径：
#     ref  r:/WORK/VFAlu/vfalus_<k>/<...>   <->   impl i:/WORK/VFAlu/u_core/vfalus_<k>/u_core/<...>
#   两个实例各一遍 = 2 x 536 = 1072；另加 32 对常量寄存器：F32WidenF16Mixed ×2 / F16 ×2 四条 lane 的 io_fflags_r_1[3:0]
#   （非加减类 fflags 低 4 位恒 0）↔ s1_fflags_stage0[3:0]——lane 内部的非正式试跑（make fm-VFAlu FM_MODE=diagnostic-full，
#   native SUCCEEDED passing 5319）实测其中两对被签名匹配交叉配到兄弟 lane 上成 unmatched（2+2），全部按实例一一钉死。
#   期望共 1104（字面）。本外壳自己的寄存器名与 golden 同名（或交签名匹配），不钉。
# 用 -type cell。钉错不会被放过：钉上的一对仍要逐点证等价，错配 = failing。
# fail-closed：逐条数 set_user_match 返回值；拒一条或总数 != 1104 就 error。进 fm.log 的输出全 ASCII。
# =============================================================================
set _vfalup_expect 1104
set _vfalup_n 0
set _vfalup_bad 0
if {[set_user_match -type cell r:/WORK/VFAlu/vfalus_0/U_F64_Widen_0/fp_a_is_zero_reg_reg i:/WORK/VFAlu/u_core/vfalus_0/u_core/U_F64_Widen_0/u_core/s1_a_is_zero_reg]} { incr _vfalup_n } else { incr _vfalup_bad; puts "VFALUP_PIN_PRE_FAIL: fp_a_is_zero_reg_reg" }
