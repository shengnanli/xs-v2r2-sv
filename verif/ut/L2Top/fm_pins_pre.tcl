set ::TL2_PIN_OK 0
set ::TL2_PIN_BAD 0
proc tl2_pin {r i} {
  if {[set_user_match "r:/WORK/L2Top/$r" "i:/WORK/L2Top/$i"]} { incr ::TL2_PIN_OK } else {
    incr ::TL2_PIN_BAD
    if {$::TL2_PIN_BAD <= 10} { puts "TL2_PIN_FAIL: $r <-> $i" }
  }
}
proc tl2_pinw {r i w} {
