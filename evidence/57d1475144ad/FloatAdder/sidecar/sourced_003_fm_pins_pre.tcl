# ---- 本层补钉：F32Adder 里 “a 为零时结果 = ±b” 的两个打拍寄存器 ----
# golden FloatAdderF32F16MixedPipeline: fadd0_result1_r   <= {io_is_sub ^ io_fp_b[31], io_fp_b[30:0]}
#                                       fadd0_result1_r_1 <= {16'h0, io_is_sub ^ io_fp_b[15], io_fp_b[14:0]}
# 重写件 xs 核:                         b_signed_f32_q    <= {is_sub ^ fp_b[31], fp_b[30:0]}
#                                       b_signed_f16_q    <= {16'h0, is_sub ^ fp_b[15], fp_b[14:0]}
# 逐位同式。子目标单独签核时 FM 自动配上；在 FloatAdder 层 [9:4]、[11] 共 7 位按签名配不上，这里逐位一对一钉。
set ::FA_F32B_OK 0
foreach b {4 5 6 7 8 9 11} {
  if {[set_user_match "r:/WORK/FloatAdder/F32Adder/fadd0_result1_r_reg\[$b\]" "i:/WORK/FloatAdder/F32Adder/u_core/b_signed_f32_q_reg\[$b\]"]} { incr ::FA_F32B_OK } else { puts "FA_PIN_FAIL: f32 b $b" }
  if {[set_user_match "r:/WORK/FloatAdder/F32Adder/fadd0_result1_r_1_reg\[$b\]" "i:/WORK/FloatAdder/F32Adder/u_core/b_signed_f16_q_reg\[$b\]"]} { incr ::FA_F32B_OK } else { puts "FA_PIN_FAIL: f16 b $b" }
}
puts "FA_PIN_END f32b ok=$::FA_F32B_OK expect=14"
if {$::FA_F32B_OK != 14} { error "FA_F32B_PIN_COUNT=$::FA_F32B_OK expect=14" }
