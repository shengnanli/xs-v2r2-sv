# VectorFloatFMA FM「匹配前」钉点 —— 自动生成：scripts/gen_vfma.py（勿手改）
#
# 只消 golden 扁平寄存器名与重写核（u_core + 七个通道实例）寄存器名之间的命名鸿沟。
# set_user_match 只声明两点对应，比较照比：不约束 ref、不改 appvar、不加黑盒。
# fail-closed：set_user_match 不抛异常（返回 0 = 没配上），所以逐条数返回值；
# 拒一条或总数不等于字面整数（= golden 顶层 301 个寄存器的位数）就 error。
# 末尾 4 条是子模块 U_CSAnto2（重写件）的流水线寄存器。进 fm.log 的输出一律 ASCII。
set ::VFMA_PIN_EXPECT 1754
set ::VFMA_PIN_OK 0
set ::VFMA_PIN_BAD 0
proc vfma_pin {g i w} {
  if {$w == 1} {
    set pairs [list "r:/WORK/VectorFloatFMA/${g}_reg" "i:/WORK/VectorFloatFMA/u_core/${i}"]
  } else {
    set pairs {}
    for {set b 0} {$b < $w} {incr b} {
      lappend pairs "r:/WORK/VectorFloatFMA/${g}_reg\[$b\]" "i:/WORK/VectorFloatFMA/u_core/${i}\[$b\]"
    }
  }
  foreach {r m} $pairs {
    if {[set_user_match $r $m]} { incr ::VFMA_PIN_OK } else {
      incr ::VFMA_PIN_BAD
      if {$::VFMA_PIN_BAD <= 10} { puts "VFMA_PIN_FAIL: $r <-> $m" }
    }
  }
}
