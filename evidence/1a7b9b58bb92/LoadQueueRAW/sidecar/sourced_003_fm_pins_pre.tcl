# LoadQueueRAW FM「匹配前」钉点 —— 自动生成：scripts/gen_lqraw.py（勿手改）
#
# 只消 golden 扁平寄存器名与重写核按字段数组名之间的命名鸿沟（依据见生成器注释）。
# set_user_match 只是声明两点对应，比较照比：不约束 ref、不改 appvar、不加黑盒。
# fail-closed：set_user_match 从不抛异常（返回 0 = 没配上），所以逐条数返回值；
# 拒一条或总数不等于字面整数（= golden 顶层寄存器位数）就 error（safe interp 里不用 exit）。
# 子模块（paddrModule / maskModule / freeList / 延迟件）内部不钉，交给 FM 自动配对。
# 进 fm.log 的输出一律 ASCII。
set ::LQRAW_PIN_EXPECT 4196
set ::LQRAW_PIN_OK 0
set ::LQRAW_PIN_BAD 0
proc lqraw_pin {g i w} {
  if {$w == 1} {
    set pairs [list "r:/WORK/LoadQueueRAW/${g}_reg" "i:/WORK/LoadQueueRAW/u_core/${i}"]
  } else {
    set pairs {}
    for {set b 0} {$b < $w} {incr b} {
      lappend pairs "r:/WORK/LoadQueueRAW/${g}_reg\[$b\]" "i:/WORK/LoadQueueRAW/u_core/${i}\[$b\]"
    }
  }
  foreach {r m} $pairs {
    if {[set_user_match $r $m]} { incr ::LQRAW_PIN_OK } else {
      incr ::LQRAW_PIN_BAD
      if {$::LQRAW_PIN_BAD <= 10} { puts "LQRAW_PIN_FAIL: $r <-> $m" }
    }
  }
}
puts "LQRAW_PIN_BEGIN LoadQueueRAW expect=$::LQRAW_PIN_EXPECT"
