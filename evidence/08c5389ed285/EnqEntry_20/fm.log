        [expr {[info exists env(XSSV_HOME)] ? [file join $env(XSSV_HOME) verif fm_target_config] : ""}]] {
    if {$_cand ne "" && [file isdirectory $_cand]} { set ::FM_TARGET_CONFIG_DIR $_cand ; break }
}
