GOLDEN_SRCS = $(GOLDEN_RTL)/XSTile.sv

FM_VARIANTS = XSTile
# ★FM（层次化组合，照 MemBlock / Backend / codex 0226）★：6 个直接实例全部 exact green_child，两侧 -interface_only，
# verif/allow/XSTile.json 逐实例绑定 child 证书 sha256。
# ★证书未齐★：XSCore（本 lane，official 等 Backend 证书）、IntBuffer / IntBuffer_1 / IntBuffer_2（已有 SUCCEEDED receipt，
#   未出证书）三种 design 的 certificate_sha256 是占位；L2Top 证书 current-valid 已盖。见 docs/lanes/xscore-xstile-asm.md。
# ref 侧（字面文件名）：5 种直接子模块的 golden 定义（只取端口）。
FM_REF_DEPS_XSTile = XSCore.sv L2Top.sv IntBuffer.sv IntBuffer_1.sv IntBuffer_2.sv
# impl 侧：5 种直接子模块的重写 wrapper（只取端口；各文件自带核，无外部 import）+ 本层重写件。
FM_IMPL_RTL = $(XSSV_HOME)/rtl/xstile/XSCore.sv $(XSSV_HOME)/rtl/l2/L2Top.sv $(XSSV_HOME)/rtl/backend/IntBuffer.sv \
              $(XSSV_HOME)/rtl/backend/IntBuffer_1.sv $(XSSV_HOME)/rtl/backend/IntBuffer_2.sv \
              $(XSSV_HOME)/rtl/xstile/XSTile.sv
fm-XSTile: RTL_SRCS = $(FM_IMPL_RTL)
fm-XSTile: RTL_GOLDEN_DEPS =
FM_INTERFACE_ONLY = XSCore L2Top IntBuffer IntBuffer_1 IntBuffer_2
FM_MODE = assembly
# 不合并重复寄存器：比较点 = 输出位 + 黑盒输入位（本层 0 寄存器），fm_predict 模型严格适用。
FM_MERGE_DUP = false
PORTLINT_ORDER = fail

include ../../../scripts/ut_common.mk

# golden 的 `ifndef SYNTHESIS 段调用未定义的 xs_assert_v2 等，两侧统一定义 SYNTHESIS。
# 初值档（编译期打开机制，运行期选档）：INITREG=0 / 1 —— 全设计常量初值。
VCS += +define+SYNTHESIS +vcs+initreg+random
INITREG ?= 0
ifneq ($(filter $(INITREG),0 1),$(INITREG))
$(error INITREG 只认 0 / 1)
endif
SIM_ARGS += +vcs+initreg+$(INITREG)

.PHONY: gencheck gentb
gencheck:
	python3 ../../../scripts/gen_xscore_xstile.py --check
	python3 gen.py --check
gentb:
	python3 gen.py

# 一档 UT = run（输出逐拍比对 + COVERS）+ covcheck（子模块输入引脚逐拍比对 + 按名字的翻转豁免），两者都过才算过。
#   make ut SEED=<1|7|42> INITREG=<0|1>   → sim_<SEED>_initreg<INITREG>.log
.PHONY: ut
ut: run
	python3 gen.py --covcheck sim_$(SEED)_initreg$(INITREG).log
