# =============================================================================
# TLBFA 家族「匹配后」钉点：把 golden 与重写核里**同为死位**的 reqVpn 高 11 位
# 逐位一一配对。由 ut_common.mk 作为 FM_PIN_TCL 传入（在首次 match 之后执行）。
#
# 为什么需要它
# ------------
# strict 首跑四个变体都是 native SUCCEEDED / failing 0 / unmatched 0，唯一卡点是
# `11 × PORTS` 个 **unmatched unread** 点：ref 侧 reqVpn[_N]_reg[27..37] ↔
# impl 侧 u_core/g_port[N].req_vpn_q_reg[27..37]。
#
# 这些位为什么两侧都死：reqVpn(= RegNext(vpn)) 的**唯一**读出点是 genPPN，而 genPPN
# 最高只取到 vpn[26:18]（三段 9 位）。golden 里对 reqVpn 的全部切片实测就是
# [26:18] / [17:9] / [8:0] / [3:0] / [2:0]，bit37..27 没有任何读者；重写核同构，
# 所以是**对称死位**，不是哪一侧漏了逻辑。
# （把重写核的 req_vpn_q 收窄成 27 位反而会制造不对称：golden 那 11×PORTS 位会变成
#   golden-only 死位，更难签。照抄 golden 的宽度是对的。）
#
# fm_eq.tcl 的 auto_match_flattened_arrays 配不上它们：那个 proc 读的是
# report_unmatched_points 的**默认**报告，而默认报告不含 unread 类
# （fm_eq.tcl 自己在导出 unread_points.txt 时也注明了这点，必须显式 -status unread）。
#
# ★fail-closed★
# set_user_match 对**不存在的名字不报错**（本仓实测：喂完全不存在的路径照样返回 0，
# catch 抓不到），所以"钉了 N 条"本身什么都不证明。本脚本的判据是钉完再 match 之后
# **重新枚举**：ref/impl 两侧的 unmatched unread 必须双双归零，否则 exit 3。
# 另外钉点集合与实测未读点集合要精确相等——多钉会抢走已配好的点，漏钉会继续拦着
# strict，只查"每条都钉上了"这两种错都抓不到。
#
# 注意：钉点只让这些点从"未匹配未读"变成"已匹配未读"，**不会**让 FM 去比它们。
# 真正把它们证掉要靠 verify_matched_unread 加强（那是加强不是放宽：FM 把未读点当作
# 真比较点去证，passing 必须增加）。该加强的白名单在 scripts/fm_eq.tcl，由集成者维护。
# =============================================================================

proc tlbfa_unread_set {side} {
    set out {}
    foreach p [lsort -unique [report_unmatched_points -$side -status unread -list]] {
        lappend out $p
    }
    return $out
}

set _ref_unread  [tlbfa_unread_set reference]
set _impl_unread [tlbfa_unread_set implementation]

if {[llength $_ref_unread] == 0 && [llength $_impl_unread] == 0} {
    puts "TLBFA_PINS: 没有未匹配的未读点，无需钉点"
} else {
    # 逐条按结构规则推出对侧路径：ref reqVpn[_N]_reg\[b\] -> impl g_port\[N\].req_vpn_q_reg\[b\]
    set _pinned 0
    foreach r $_ref_unread {
        if {![regexp {reqVpn(?:_(\d+))?_reg\[(\d+)\]$} $r -> port bit]} {
            puts "TLBFA_PIN_ERROR: 未预期的 ref 未读点 $r （只应有 reqVpn 高位死位）"
            exit 3
        }
        if {$port eq ""} { set port 0 }
        set i "i:/WORK/$top/u_core/g_port\[$port\].req_vpn_q_reg\[$bit\]"
        if {[lsearch -exact $_impl_unread $i] < 0} {
            puts "TLBFA_PIN_ERROR: ref $r 推出的 impl 路径 $i 不在实测未读集合里"
            exit 3
        }
        if {[catch {set_user_match $r $i} _msg]} {
            puts "TLBFA_PIN_ERROR: set_user_match $r $i 失败: $_msg"
            exit 3
        }
        incr _pinned
    }
    if {$_pinned != [llength $_impl_unread]} {
        puts "TLBFA_PIN_ERROR: 钉了 $_pinned 条，但 impl 侧未读点有 [llength $_impl_unread] 个 —— 不是双射"
        exit 3
    }
    puts "TLBFA_PINS: 钉了 $_pinned 对 reqVpn 死位（ref [llength $_ref_unread] / impl [llength $_impl_unread]）"

    # ★fail-closed 复核★：钉完重新 match，再枚举一次，两侧必须都归零。
    match
    set _r2 [tlbfa_unread_set reference]
    set _i2 [tlbfa_unread_set implementation]
    if {[llength $_r2] != 0 || [llength $_i2] != 0} {
        puts "TLBFA_PIN_ERROR: 钉点后仍有未匹配未读点 ref=[llength $_r2] impl=[llength $_i2]"
        puts "  ref 残余: $_r2"
        puts "  impl 残余: $_i2"
        exit 3
    }
    puts "TLBFA_PINS: 复核通过，两侧未匹配未读点均已归零"
}
