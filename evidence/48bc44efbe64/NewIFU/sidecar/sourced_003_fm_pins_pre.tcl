# NewIFU FM「匹配前」钉点 —— 自动生成：scripts/gen_newifu_lane.py（勿手改）
#
# 只消 golden 扁平寄存器名与重写核数组名之间的命名鸿沟（依据见生成器文件头）。
# set_user_match 只是声明两点对应，比较照比：不约束 ref、不改 appvar、不加黑盒。
# fail-closed：set_user_match 从不抛异常（返回 0 = 没配上），所以逐条数返回值；
# 拒一条或总数不等于字面整数（= 所列 golden 寄存器位数之和）就 error。
# 进 fm.log 的输出一律 ASCII。
set ::NEWIFU_PIN_OK 0
set ::NEWIFU_PIN_BAD 0
proc newifu_pin {g i w} {
  if {$w == 1} {
    set pairs [list "r:/WORK/NewIFU/${g}_reg" "i:/WORK/NewIFU/${i}"]
  } else {
    set pairs {}
    for {set b 0} {$b < $w} {incr b} {
      lappend pairs "r:/WORK/NewIFU/${g}_reg\[$b\]" "i:/WORK/NewIFU/${i}\[$b\]"
    }
  }
  foreach {r m} $pairs {
    if {[set_user_match $r $m]} { incr ::NEWIFU_PIN_OK } else {
      incr ::NEWIFU_PIN_BAD
      if {$::NEWIFU_PIN_BAD <= 10} { puts "NEWIFU_PIN_FAIL: $r <-> $m" }
    }
  }
}
