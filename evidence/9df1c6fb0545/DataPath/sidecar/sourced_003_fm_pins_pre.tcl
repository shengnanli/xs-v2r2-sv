# DataPath FM「匹配前」钉点 —— 自动生成：scripts/gen_datapath.py（勿手改）
#
# 只消 golden 平铺寄存器名与重写件数组名之间的命名鸿沟：
#   顶层：golden DataPath 的 1,111 个寄存器 ↔ 核 u_core 里的数组元素（映射规则见生成器 top_pin_map，
#         每个 golden 寄存器必须恰好命中一条规则，否则生成失败）；
#   子模块：重写的寄存器堆（mem_<i> ↔ u_core/mem_reg[i]，读地址寄存器 ↔ u_core/read_addr_q / raddr_q）
#         与 WBArbiter（cancelCounter/isFull/hasFull ↔ u_core/cancel_cnt_q/is_full_q/has_full_q）。
#   RegCache 内部不钉，交给 FM 自动配对。
# set_user_match 只声明两点对应，比较照比：不约束 ref、不改 appvar、不加黑盒。
# fail-closed：set_user_match 从不抛异常（返回 0 = 没配上），逐条数返回值；拒一条或总数不等于
# 字面整数就 error（safe interp 里不用 exit）。进 fm.log 的输出一律 ASCII。
set ::DP_PIN_EXPECT 57191
set ::DP_PIN_OK 0
set ::DP_PIN_BAD 0
proc dp_pin {g i w} {
  if {$w == 1} {
    set pairs [list "r:/WORK/DataPath/${g}_reg" "i:/WORK/DataPath/${i}"]
  } else {
    set pairs {}
    for {set b 0} {$b < $w} {incr b} {
      lappend pairs "r:/WORK/DataPath/${g}_reg\[$b\]" "i:/WORK/DataPath/${i}\[$b\]"
    }
  }
  foreach {r m} $pairs {
    if {[set_user_match $r $m]} { incr ::DP_PIN_OK } else {
      incr ::DP_PIN_BAD
      if {$::DP_PIN_BAD <= 10} { puts "DP_PIN_FAIL: $r <-> $m" }
    }
  }
}
# payload：golden 字段寄存器的第 b 位 ↔ u_core/s1_payload_q_reg[off+b]
proc dp_pin_pl {g off w} {
  for {set b 0} {$b < $w} {incr b} {
    if {$w == 1} { set r "r:/WORK/DataPath/${g}_reg" } else { set r "r:/WORK/DataPath/${g}_reg\[$b\]" }
    set m "i:/WORK/DataPath/u_core/s1_payload_q_reg\[[expr {$off + $b}]\]"
    if {[set_user_match $r $m]} { incr ::DP_PIN_OK } else {
      incr ::DP_PIN_BAD
      if {$::DP_PIN_BAD <= 10} { puts "DP_PIN_FAIL: $r <-> $m" }
    }
  }
}
